{
  "name": "cw-mc-launcher",
  "version": "0.1.1",
  "description": "Minecraft Java client launcher by Cube Watcher",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p src/renderer/tsconfig.json"
  },
  "build": {
    "appId": "com.cubewatcher.cwmclauncher",
    "productName": "CW-MC Launcher",
    "copyright": "Copyright © 2025 Cube Watcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CW-MC Launcher",
      "uninstallDisplayName": "CW-MC Launcher"
    },
    "portable": {
      "artifactName": "CW-MC-Launcher-${version}-portable.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "JesusGonzalezGs",
      "repo": "cw-mc-launcher"
    }
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.3",
    "unzipper": "^0.12.3",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/unzipper": "^0.10.10",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.20",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "lucide-react": "^0.469.0",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.0.0",
    "vite": "^5.4.0"
  }
}
